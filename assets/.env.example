# Copy to .env and fill in locally. Do not commit .env or paste it in chat.

# Enterprise IMAP account to read
WORK_IMAP_HOST=imap.example.com
WORK_IMAP_PORT=993
WORK_IMAP_USERNAME=you@example.com
WORK_IMAP_PASSWORD=your-imap-password-or-app-token
WORK_IMAP_FOLDER=INBOX

# SMTP account used to send the digest (often the same mailbox)
DIGEST_SMTP_HOST=smtp.example.com
DIGEST_SMTP_PORT=465
DIGEST_SMTP_USERNAME=you@example.com
DIGEST_SMTP_PASSWORD=your-smtp-password-or-app-token
DIGEST_TO=you@example.com

# Optional: absolute path to the state file (defaults to ./mail_digest_state.json)
# MAIL_DIGEST_STATE=/absolute/path/mail_digest_state.json
